---
import Nav from '../components/Nav.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current: 'home' | 'planes' | 'ablandadores' | 'contacto';
}
const { title, description, current } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <Nav current={current} />
  <main>
    <slot />
  </main>
  <WhatsAppFab />
</body>
</html>
