---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import dispenser from '../assets/dispenser.png';
import ablandadorCompleto from '../assets/ablandador-completo.png';
---

<Layout
  title="Alquileres Dervo — Agua filtrada y ablandada para oficinas y edificios"
  description="Dispensers de agua filtrada y ablandadores para oficinas y edificios en CABA."
  current="home"
>
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-bg-circle"></div><div class="hero-bg-circle"></div>
      <div class="hero-bg-circle"></div><div class="hero-bg-line"></div>
    </div>
    <div class="hero-eyebrow">Tratamiento de agua profesional</div>
    <h1 class="hero-title">Agua pura.<br /><em>Sin complicaciones.</em></h1>
    <p class="hero-sub">Dispensers de agua y ablandadores sin preocupaciones.</p>
    <div class="hero-actions">
      <a class="btn-ghost" href="/planes">Nuestros productos</a>
      <a class="btn-primary" href="/contacto">Consultá ahora →</a>
    </div>
  </section>

  <div class="home-products">
    <div class="equipos-grid">
      <div class="prod-panel active">
        <div class="home-equipo-wrap">
          <div class="equipo-card premium">
            <div class="equipo-foto has-photo">
              <div class="foto-badge badge-premium">Nuestro Equipo</div>
              <Image class="foto-real" src={dispenser} alt="Dispenser Frío / Caliente Ushuaia" width={280} />
            </div>
            <div class="equipo-info">
              <div class="eq-name">Dispenser Frío / Caliente</div>
              <div class="eq-sub">Conexión directa a la red de agua corriente</div>
              <div class="eq-tags" style="margin-top:8px;"><span class="eq-tag">Filtros de alta calidad</span><span class="eq-tag">Agua fría</span><span class="eq-tag">Agua caliente</span></div>
            </div>
          </div>
        </div>
        <div style="margin-top:20px; text-align:center;">
          <a class="btn-ghost" href="/planes">Ver dispenser →</a>
        </div>
      </div>

      <div class="prod-panel active">
        <div class="home-equipo-wrap">
          <div class="equipo-card premium">
            <div class="equipo-foto has-photo">
              <div class="foto-badge badge-premium">Nuestro Equipo</div>
              <Image class="foto-real" src={ablandadorCompleto} alt="Ablandador con tanque de resina, válvula Clack y tanque salero" width={220} />
            </div>
            <div class="equipo-info">
              <div class="eq-name">Ablandador de agua</div>
              <div class="eq-sub">Se evalúa la cantidad de sarro y la demanda de agua en cada caso y se determina el equipo correspondiente.</div>
            </div>
          </div>
        </div>
        <div style="margin-top:20px; text-align:center;">
          <a class="btn-ghost" href="/planes#ablandadores">Ver ablandadores →</a>
        </div>
      </div>
    </div>
  </div>

  <div class="features-strip">
    <div class="feature-item">
      <div class="feature-title">Conectado a la red</div>
      <div class="feature-desc">Sin bidones, sin entregas. Dispensers conectados directo a la canilla con filtros de alta calidad.</div>
    </div>
    <div class="feature-item">
      <div class="feature-title">Ablandadores residenciales e industriales</div>
      <div class="feature-desc">Elimina el sarro y protegé las cañerías y electrodomésticos.</div>
    </div>
    <div class="feature-item">
      <div class="feature-title">Soporte técnico</div>
      <div class="feature-desc">Contamos con un equipo de soporte técnico profesional listo para atender.</div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .home-equipo-wrap { max-width:564px; margin:0 auto; }
  .home-equipo-wrap :global(.equipo-card) { height:449px; display:flex; flex-direction:column; }
  .home-equipo-wrap :global(.equipo-foto.has-photo) { height:316px; padding:25px 0; flex-shrink:0; box-sizing:border-box; }
  .home-equipo-wrap :global(.equipo-info) { flex:1; display:flex; flex-direction:column; justify-content:center; }
  .home-equipo-wrap :global(.eq-name) { font-size:18px; }
  .home-equipo-wrap :global(.eq-sub) { font-size:14px; }
</style>
